@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Radzen
@using Radzen.Blazor
@using AdventureGame.Engine.Components

<div class="string-hashset-editor">
    @if (Value is not null && Value.Any())
    {
        @foreach (var item in Value.OrderBy(x => x))
        {
            <AGChip Text="@item"
                    Icon="close"
                    IconButtonStyle="ButtonStyle.Light"
                    OnAction="@(() => RemoveItem(item))" />
        }
    }

    @if (!IsEditing)
    {
        <AGChip Text="Add"
                Icon="add"
                IconButtonStyle="ButtonStyle.Success"
                OnAction="StartEditing"
                Class="add-chip-custom"
                Style="background-color: var(--rz-success-light, #d1e7dd); color: var(--rz-success-dark, #0f5132); cursor: pointer; transition: background-color 0.2s;" />
    }
    else
    {
        <div class="hashset-input-inline">
            <input type="text" 
                   class="hashset-textbox" 
                   @bind="NewItem"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   @onblur="HandleBlur"
                   @ref="InputElement"
                   placeholder="@(Placeholder ?? "tag1, tag2, tag3...")" />
            <button type="button"
                    class="hashset-add-button" 
                    @onclick="ConfirmAdd"
                    disabled="@string.IsNullOrWhiteSpace(NewItem)">
                Add
            </button>
        </div>
    }
</div>

@code {
    /// <summary>
    /// The underlying string HashSet (unique string collection).
    /// </summary>
    [Parameter] public HashSet<string> Value { get; set; } = new();

    [Parameter] public EventCallback<HashSet<string>> ValueChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    private string? NewItem { get; set; }
    private bool IsEditing { get; set; }
    private ElementReference InputElement { get; set; }

    private void StartEditing()
    {
        IsEditing = true;
        NewItem = string.Empty;
        StateHasChanged();
        
        // Focus the input after render
        _ = FocusInputAsync();
    }

    private async Task FocusInputAsync()
    {
        await Task.Delay(50); // Small delay to ensure rendering is complete
        try
        {
            await InputElement.FocusAsync();
        }
        catch
        {
            // Ignore focus errors
        }
    }

    private async Task ConfirmAdd()
    {
        if (string.IsNullOrWhiteSpace(NewItem))
        {
            CancelEditing();
            return;
        }

        var parts = NewItem.Split(',', StringSplitOptions.RemoveEmptyEntries);
        var addedAny = false;
        foreach (var p in parts)
        {
            var trimmed = p.Trim();
            if (string.IsNullOrEmpty(trimmed))
                continue;

            if (Value.Add(trimmed))
                addedAny = true;
        }

        if (addedAny)
            await ValueChanged.InvokeAsync(Value);

        CancelEditing();
    }

    private void CancelEditing()
    {
        IsEditing = false;
        NewItem = string.Empty;
    }

    private async Task RemoveItem(string item)
    {
        if (Value.Remove(item))
            await ValueChanged.InvokeAsync(Value);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(NewItem))
        {
            await ConfirmAdd();
        }
        else if (e.Key == "Escape")
        {
            CancelEditing();
        }
    }

    private async Task HandleBlur()
    {
        // Small delay to allow button clicks to register before blur closes the input
        await Task.Delay(200);
        if (IsEditing && string.IsNullOrWhiteSpace(NewItem))
        {
            CancelEditing();
        }
    }
}
