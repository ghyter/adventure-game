@using AdventureGame.Components.Parameters
@inherits ParameterEditorBase

<RadzenDropDown TValue="string"
                Value="@CurrentValueAsString"
                ValueChanged="@((string? val) => CurrentValueAsString = val)"
                Data="@outputModes"
                AllowClear="false"
                Placeholder="Select output mode"
                Style="width:100%" />

@code {
    private readonly string[] outputModes = ["Description", "State", "Both"];
}
